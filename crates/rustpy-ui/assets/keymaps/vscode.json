{
  "name": "VS Code",
  "bindings": {
    "GotoAction": ["Ctrl+Shift+P", "F1"],
    "GotoFile": ["Ctrl+P"],
    "GotoSymbol": ["Ctrl+T"],
    "FileStructurePopup": ["Ctrl+Shift+O"],
    "GotoDeclaration": ["F12"],
    "GotoImplementation": ["Ctrl+F12"],
    "FindUsages": ["Shift+F12", "Alt+Shift+F12"],
    "RenameElement": ["F2"],
    "ShowIntentionActions": ["Ctrl+Period"],
    "ReformatCode": ["Alt+Shift+F"],
    "SelectNextOccurrence": ["Ctrl+D"],
    "SelectAllOccurrences": ["Ctrl+Shift+L"],
    "EditorDuplicate": ["Alt+Shift+ArrowDown"],
    "EditorDeleteLine": ["Ctrl+Shift+K"],
    "MoveLineUp": ["Alt+ArrowUp"],
    "MoveLineDown": ["Alt+ArrowDown"],
    "EditorSelectWord": ["Alt+Shift+ArrowRight"],
    "EditorUnSelectWord": ["Alt+Shift+ArrowLeft"],
    "ActivateTerminalToolWindow": ["Ctrl+Backtick"],
    "ActivateProjectToolWindow": ["Ctrl+Shift+E"],
    "HideAllWindows": ["Ctrl+B"],
    "Replace": ["Ctrl+H"],
    "ReplaceInPath": ["Ctrl+Shift+H"],
    "CloseContent": ["Ctrl+W", "Ctrl+F4"],
    "NextTab": ["Ctrl+PageDown"],
    "PreviousTab": ["Ctrl+PageUp"],
    "Back": ["Alt+ArrowLeft"],
    "Forward": ["Alt+ArrowRight"],
    "ParameterInfo": ["Ctrl+Shift+Space"],
    "ShowSettings": ["Ctrl+Comma"],
    "ToggleLineBreakpoint": ["F9"],
    "Debug": ["F5"],
    "Run": ["Ctrl+F5"],
    "Stop": ["Shift+F5"],
    "StepOver": ["F10"],
    "StepInto": ["F11"],
    "StepOut": ["Shift+F11"]
  }
}
