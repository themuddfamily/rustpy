{
  "name": "Eclipse",
  "bindings": {
    "GotoClass": ["Ctrl+Shift+T"],
    "GotoFile": ["Ctrl+Shift+R"],
    "GotoAction": ["Ctrl+3"],
    "GotoDeclaration": ["F3"],
    "FindNext": ["Ctrl+K"],
    "FindPrevious": ["Ctrl+Shift+K"],
    "GotoImplementation": ["Ctrl+T"],
    "FindUsages": ["Ctrl+Shift+G"],
    "RenameElement": ["Alt+Shift+R"],
    "ShowIntentionActions": ["Ctrl+1"],
    "ReformatCode": ["Ctrl+Shift+F"],
    "FindInPath": ["Ctrl+H"],
    "ReplaceInPath": ["Ctrl+Alt+H"],
    "EditorDeleteLine": ["Ctrl+D"],
    "EditorDuplicate": ["Ctrl+Alt+ArrowDown"],
    "MoveLineUp": ["Alt+ArrowUp"],
    "MoveLineDown": ["Alt+ArrowDown"],
    "GotoLine": ["Ctrl+L"],
    "FileStructurePopup": ["Ctrl+O"],
    "QuickJavaDoc": ["F2"],
    "IntroduceVariable": ["Alt+Shift+L"],
    "ExtractMethod": ["Alt+Shift+M"],
    "Refactorings.QuickListPopupAction": ["Alt+Shift+T"],
    "ToggleLineBreakpoint": ["Ctrl+Shift+B"],
    "Debug": ["F11"],
    "Run": ["Ctrl+F11"],
    "StepOver": ["F6"],
    "StepInto": ["F5"],
    "StepOut": ["F7"],
    "Resume": ["F8"],
    "CloseContent": ["Ctrl+W"],
    "Back": ["Alt+ArrowLeft"],
    "Forward": ["Alt+ArrowRight"],
    "NextTab": ["Ctrl+PageDown"],
    "PreviousTab": ["Ctrl+PageUp"]
  }
}
