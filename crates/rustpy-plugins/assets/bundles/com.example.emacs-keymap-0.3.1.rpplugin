{
  "format": "rustpy-plugin",
  "version": 1,
  "files": {
    "keymaps/emacs.json": "{\n  \"name\": \"Emacs\",\n  \"bindings\": {\n    \"EditorLineStart\": [\"Home\", \"Ctrl+A\"],\n    \"EditorLineEnd\": [\"End\", \"Ctrl+E\"],\n    \"EditorNextWord\": [\"Ctrl+ArrowRight\", \"Alt+F\"],\n    \"EditorPreviousWord\": [\"Ctrl+ArrowLeft\", \"Alt+B\"],\n    \"EditorTextStart\": [\"Ctrl+Home\", \"Alt+Shift+Comma\"],\n    \"EditorTextEnd\": [\"Ctrl+End\", \"Alt+Shift+Period\"],\n    \"EditorEscape\": [\"Escape\", \"Ctrl+G\"],\n    \"$Copy\": [\"Ctrl+C\", \"Ctrl+Insert\"],\n    \"$Paste\": [\"Ctrl+V\", \"Shift+Insert\"],\n    \"PasteMultiple\": [\"Ctrl+Shift+V\"],\n    \"$Undo\": [\"Ctrl+Z\", \"Ctrl+Slash\"],\n    \"$SelectAll\": [\"Ctrl+Alt+A\"],\n    \"CommentByLineComment\": [\"Alt+Semicolon\"],\n    \"EditorDeleteLine\": [\"Ctrl+Shift+Y\"],\n    \"GotoLine\": [\"Alt+G\"],\n    \"GotoAction\": [\"Ctrl+Shift+A\", \"Alt+X\"],\n    \"RecentFiles\": [\"Ctrl+Alt+E\"],\n    \"CheckinProject\": [\"Ctrl+Alt+K\"],\n    \"EditorEmacsKillLine\": [\"Ctrl+K\"],\n    \"EditorEmacsKillWordForward\": [\"Alt+D\"],\n    \"EditorEmacsKillWordBackward\": [\"Alt+Backspace\"],\n    \"EditorEmacsYank\": [\"Ctrl+Y\"],\n    \"EditorEmacsYankPop\": [\"Alt+Y\"],\n    \"EditorEmacsTranspose\": [\"Ctrl+T\"],\n    \"EditorEmacsKillRegion\": [\"Ctrl+W\"],\n    \"EditorEmacsCopyRegion\": [\"Alt+W\"],\n    \"EditorDeleteToWordEnd\": [\"Ctrl+Delete\"],\n    \"EditorDeleteToWordStart\": [\"Ctrl+Backspace\"]\n  }\n}\n",
    "plugin.json": "{\n  \"id\": \"com.example.emacs-keymap\",\n  \"name\": \"Emacs Keymap\",\n  \"version\": \"0.3.1\",\n  \"description\": \"Emacs-style shortcuts layered over the Default keymap. Chord sequences such as Ctrl+X Ctrl+S are not supported, so they are approximated by single chords (Alt+W copies, Ctrl+Y pastes, Ctrl+G cancels, Alt+X finds an action).\",\n  \"vendor\": \"RustPy Examples\",\n  \"homepage\": \"https://example.com/rustpy-plugins/emacs-keymap\",\n  \"contributes\": {\n    \"keymaps\": [\"keymaps/emacs.json\"]\n  }\n}\n"
  }
}
