{
  "format": "rustpy-plugin",
  "version": 1,
  "files": {
    "LICENSE.solarized": "Copyright (c) 2011 Ethan Schoonover\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in\nall copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\nTHE SOFTWARE.\n\n",
    "NOTICE.solarized": "Solarized palette notice\n\nThe Solarized palette is by Ethan Schoonover, copyright (c) 2011,\nand is provided under the MIT license reproduced in LICENSE.solarized.\n\nUpstream project: https://github.com/altercation/solarized\nAuthor's project page: https://ethanschoonover.com/solarized/\nUpstream revision observed on 2026-10-15:\n62f656a02f93c5190a8753159e34b385588d5ff3\nPinned license source:\nhttps://raw.githubusercontent.com/altercation/solarized/62f656a02f93c5190a8753159e34b385588d5ff3/LICENSE\nSHA-256 of the exact LICENSE.solarized bytes:\n494aefdabf86acce06bd63001ad8aedad4ee38da23509d3f917d95aa3368b9a6\n\nThis RustPy example adapts the Solarized palette to RustPy's editor scheme\nformat and includes RustPy Python live templates. The revision above pins\nthe license checked for this notice; it does not establish the revision or\nsource file used for the historical palette import. That import provenance\nis not recorded here. The palette has not been changed by this notice update.\n",
    "colors/solarized-dark.json": "{\n  \"name\": \"Solarized Dark (Plugin)\",\n  \"base\": \"Dark\",\n  \"colors\": {\n    \"Default\": \"#839496\",\n    \"Keyword\": \"#859900\",\n    \"SoftKeyword\": \"#859900\",\n    \"Builtin\": \"#268bd2\",\n    \"SelfParameter\": { \"fg\": \"#6c71c4\", \"italic\": true },\n    \"Decorator\": \"#b58900\",\n    \"FunctionDefinition\": \"#268bd2\",\n    \"ClassDefinition\": { \"fg\": \"#b58900\", \"bold\": true },\n    \"FunctionCall\": \"#839496\",\n    \"Number\": \"#d33682\",\n    \"String\": \"#2aa198\",\n    \"Bytes\": \"#2aa198\",\n    \"FString\": \"#2aa198\",\n    \"FStringBrace\": \"#cb4b16\",\n    \"EscapeSequence\": \"#dc322f\",\n    \"Docstring\": { \"fg\": \"#586e75\", \"italic\": true },\n    \"Comment\": { \"fg\": \"#586e75\", \"italic\": true },\n    \"TodoComment\": { \"fg\": \"#d33682\", \"bold\": true, \"italic\": false },\n    \"Operator\": \"#93a1a1\",\n    \"Punctuation\": \"#839496\",\n    \"Comma\": \"#93a1a1\",\n    \"Dunder\": \"#6c71c4\",\n    \"KeywordArgument\": \"#cb4b16\",\n    \"Parameter\": \"#839496\",\n    \"Key\": \"#268bd2\",\n    \"Tag\": \"#268bd2\",\n    \"Heading\": { \"fg\": \"#cb4b16\", \"bold\": true },\n    \"Link\": { \"fg\": \"#6c71c4\", \"underline\": true },\n    \"Variable\": \"#b58900\",\n    \"Error\": { \"fg\": \"#dc322f\", \"underline\": true }\n  },\n  \"editor\": {\n    \"background\": \"#002b36\",\n    \"foreground\": \"#839496\",\n    \"caret\": \"#93a1a1\",\n    \"caret_row\": \"#073642\",\n    \"selection\": \"#274642\",\n    \"selection_inactive\": \"#0a3a45\",\n    \"line_number\": \"#586e75\",\n    \"line_number_current\": \"#93a1a1\",\n    \"gutter_background\": \"#002b36\",\n    \"gutter_separator\": \"#073642\",\n    \"indent_guide\": \"#0b3c47\",\n    \"indent_guide_active\": \"#2a5560\",\n    \"right_margin\": \"#073642\",\n    \"whitespace\": \"#0e4552\",\n    \"matched_brace_bg\": \"#1d4e4a\",\n    \"search_result_bg\": \"#4b4a12\",\n    \"folded_text_bg\": \"#073642\",\n    \"folded_text_fg\": \"#93a1a1\",\n    \"sticky_lines_bg\": \"#04313c\",\n    \"inlay_hint_bg\": \"#073642\",\n    \"inlay_hint_fg\": \"#657b83\"\n  }\n}\n",
    "plugin.json": "{\n  \"id\": \"com.example.solarized-theme\",\n  \"name\": \"Solarized Theme\",\n  \"version\": \"1.0.0\",\n  \"description\": \"The Solarized Dark editor color scheme (palette by Ethan Schoonover) and a few Python live templates.\",\n  \"vendor\": \"RustPy Examples\",\n  \"homepage\": \"https://github.com/altercation/solarized\",\n  \"min_ide_version\": \"0.1.0\",\n  \"contributes\": {\n    \"color_schemes\": [\"colors/solarized-dark.json\"],\n    \"live_templates\": [\"templates/python.json\"]\n  }\n}\n",
    "templates/python.json": "[\n  {\n    \"abbreviation\": \"bp\",\n    \"description\": \"Pause in the debugger: breakpoint()\",\n    \"template\": \"breakpoint()$END$\",\n    \"contexts\": [\"Statement\"]\n  },\n  {\n    \"abbreviation\": \"logger\",\n    \"description\": \"Module-level logger\",\n    \"template\": \"logger = logging.getLogger(__name__)$END$\",\n    \"contexts\": [\"Module\"]\n  },\n  {\n    \"abbreviation\": \"todo\",\n    \"description\": \"TODO comment signed with the user name\",\n    \"text\": \"# TODO($USER$): $END$\",\n    \"context\": \"Statement\",\n    \"variables\": [{ \"name\": \"USER\", \"expression\": \"user()\", \"default\": \"me\", \"always_stop_at\": false }]\n  }\n]\n"
  }
}
