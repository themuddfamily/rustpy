{
  "format": "rustpy-plugin",
  "version": 1,
  "files": {
    "file-templates/conftest.py": "\"\"\"Shared pytest fixtures for ${PROJECT_NAME} (created ${DATE}).\"\"\"\n\nimport pytest\n\n\n@pytest.fixture\ndef tmp_project(tmp_path):\n    \"\"\"An empty project directory for a test.\"\"\"\n    return tmp_path\n",
    "file-templates/test_module.py": "\"\"\"Tests for ${NAME} (created ${DATE} by ${USER}).\"\"\"\n\nimport pytest\n\n\n@pytest.fixture\ndef subject():\n    return None\n\n\ndef test_subject_is_empty(subject):\n    assert subject is None\n",
    "plugin.json": "{\n  \"id\": \"com.example.pytest-kit\",\n  \"name\": \"Pytest Kit\",\n  \"version\": \"2.1.0\",\n  \"description\": \"File templates for pytest modules and conftest.py, live templates for fixtures, parametrize and raises, and a \\\"pytest current file\\\" external tool.\",\n  \"vendor\": \"RustPy Examples\",\n  \"homepage\": \"https://example.com/rustpy-plugins/pytest-kit\",\n  \"contributes\": {\n    \"live_templates\": [\"templates/pytest.json\"],\n    \"file_templates\": [\n      { \"name\": \"Pytest Module\", \"extension\": \"py\", \"path\": \"file-templates/test_module.py\" },\n      { \"name\": \"Pytest conftest.py\", \"extension\": \"py\", \"path\": \"file-templates/conftest.py\" }\n    ],\n    \"external_tools\": [\n      {\n        \"name\": \"pytest current file\",\n        \"program\": \"python3\",\n        \"arguments\": \"-m pytest -q \\\"$FilePath$\\\"\",\n        \"working_dir\": \"$ProjectFileDir$\",\n        \"group\": \"Pytest\",\n        \"show_console\": true\n      }\n    ]\n  }\n}\n",
    "templates/pytest.json": "[\n  {\n    \"abbreviation\": \"fixture\",\n    \"description\": \"pytest fixture\",\n    \"template\": \"@pytest.fixture\\ndef $NAME$():\\n    $END$\",\n    \"contexts\": [\"Statement\", \"Module\"],\n    \"group\": \"Pytest\"\n  },\n  {\n    \"abbreviation\": \"param\",\n    \"description\": \"@pytest.mark.parametrize decorator\",\n    \"template\": \"@pytest.mark.parametrize(\\\"$ARGS$\\\", [$END$])\",\n    \"contexts\": [\"Statement\", \"Module\", \"ClassBody\"],\n    \"group\": \"Pytest\"\n  },\n  {\n    \"abbreviation\": \"raises\",\n    \"description\": \"with pytest.raises(...)\",\n    \"template\": \"with pytest.raises($EXCEPTION$):\\n    $END$\",\n    \"contexts\": [\"Statement\"],\n    \"group\": \"Pytest\",\n    \"variables\": [{ \"name\": \"EXCEPTION\", \"expression\": \"\", \"default\": \"ValueError\", \"always_stop_at\": true }]\n  }\n]\n"
  }
}
