<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A reduced Rust grammar written for the rustpy-textmate tests. -->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Rust Lite</string>
	<key>scopeName</key>
	<string>source.rust-lite</string>
	<key>fileTypes</key>
	<array>
		<string>rlite</string>
	</array>
	<key>patterns</key>
	<array>
		<dict><key>include</key><string>#comments</string></dict>
		<dict><key>include</key><string>#attributes</string></dict>
		<dict><key>include</key><string>#block</string></dict>
		<dict><key>include</key><string>#items</string></dict>
		<dict><key>include</key><string>#keywords</string></dict>
		<dict><key>include</key><string>#lifetimes</string></dict>
		<dict><key>include</key><string>#chars</string></dict>
		<dict><key>include</key><string>#raw-strings</string></dict>
		<dict><key>include</key><string>#strings</string></dict>
		<dict><key>include</key><string>#numbers</string></dict>
		<dict><key>include</key><string>#macros</string></dict>
		<dict><key>include</key><string>#variables</string></dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>comment.line.double-slash.rust-lite</string>
					<key>match</key>
					<string>//.*$</string>
				</dict>
				<dict><key>include</key><string>#block-comment</string></dict>
			</array>
		</dict>
		<key>block-comment</key>
		<dict>
			<key>comment</key>
			<string>Rust block comments nest: the rule includes itself.</string>
			<key>name</key>
			<string>comment.block.rust-lite</string>
			<key>begin</key>
			<string>/\*</string>
			<key>end</key>
			<string>\*/</string>
			<key>patterns</key>
			<array>
				<dict><key>include</key><string>#block-comment</string></dict>
			</array>
		</dict>
		<key>attributes</key>
		<dict>
			<key>name</key>
			<string>meta.attribute.rust-lite</string>
			<key>begin</key>
			<string>(#)(!?)(\[)</string>
			<key>end</key>
			<string>\]</string>
			<key>beginCaptures</key>
			<dict>
				<key>1</key>
				<dict><key>name</key><string>punctuation.definition.attribute.rust-lite</string></dict>
				<key>3</key>
				<dict><key>name</key><string>punctuation.brackets.attribute.rust-lite</string></dict>
			</dict>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict><key>name</key><string>punctuation.brackets.attribute.rust-lite</string></dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict><key>include</key><string>#strings</string></dict>
			</array>
		</dict>
		<key>block</key>
		<dict>
			<key>comment</key>
			<string>Blocks contain the base grammar (the embedding one when embedded).</string>
			<key>name</key>
			<string>meta.block.rust-lite</string>
			<key>begin</key>
			<string>\{</string>
			<key>end</key>
			<string>\}</string>
			<key>patterns</key>
			<array>
				<dict><key>include</key><string>$base</string></dict>
			</array>
		</dict>
		<key>items</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(fn)\s+([a-z_][a-z0-9_]*)</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict><key>name</key><string>storage.type.fn.rust-lite</string></dict>
						<key>2</key>
						<dict><key>name</key><string>entity.name.function.rust-lite</string></dict>
					</dict>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(struct|enum|trait)\s+([A-Z][A-Za-z0-9_]*)</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict><key>name</key><string>storage.type.$1.rust-lite</string></dict>
						<key>2</key>
						<dict><key>name</key><string>entity.name.type.$1.rust-lite</string></dict>
					</dict>
				</dict>
			</array>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.control.rust-lite</string>
					<key>match</key>
					<string>\b(?:if|else|match|loop|while|for|in|return|break|continue)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.modifier.rust-lite</string>
					<key>match</key>
					<string>\b(?:pub|mut|let|const|static|impl|use|mod)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.rust-lite</string>
					<key>match</key>
					<string>=&gt;|-&gt;|::|\.\.|[-+*/%=&lt;&gt;!&amp;|]=?</string>
				</dict>
			</array>
		</dict>
		<key>lifetimes</key>
		<dict>
			<key>match</key>
			<string>(')([a-z_][a-z0-9_]*)(?!')</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict><key>name</key><string>punctuation.definition.lifetime.rust-lite</string></dict>
				<key>2</key>
				<dict><key>name</key><string>entity.name.type.lifetime.rust-lite</string></dict>
			</dict>
		</dict>
		<key>chars</key>
		<dict>
			<key>name</key>
			<string>string.quoted.single.char.rust-lite</string>
			<key>match</key>
			<string>'(?:[^'\\]|\\.)'</string>
		</dict>
		<key>raw-strings</key>
		<dict>
			<key>comment</key>
			<string>r#"…"#: the end repeats the begin's hashes (a back-reference).</string>
			<key>name</key>
			<string>string.quoted.double.raw.rust-lite</string>
			<key>begin</key>
			<string>(r)(#*)"</string>
			<key>end</key>
			<string>"\2</string>
			<key>beginCaptures</key>
			<dict>
				<key>1</key>
				<dict><key>name</key><string>storage.type.string.rust-lite</string></dict>
			</dict>
		</dict>
		<key>strings</key>
		<dict>
			<key>name</key>
			<string>string.quoted.double.rust-lite</string>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.rust-lite</string>
					<key>match</key>
					<string>\\(?:[nrt0\\'"]|x\h{2}|u\{\h{1,6}\})</string>
				</dict>
			</array>
		</dict>
		<key>numbers</key>
		<dict>
			<key>name</key>
			<string>constant.numeric.decimal.rust-lite</string>
			<key>match</key>
			<string>\b\d[\d_]*(?:\.\d[\d_]*)?(?:[iu](?:8|16|32|64|128|size)|f32|f64)?\b</string>
		</dict>
		<key>macros</key>
		<dict>
			<key>match</key>
			<string>\b([a-z_][a-z0-9_]*)(!)(?=\s*[(\[{])</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict><key>name</key><string>entity.name.function.macro.rust-lite</string></dict>
				<key>2</key>
				<dict><key>name</key><string>keyword.operator.macro.rust-lite</string></dict>
			</dict>
		</dict>
		<key>variables</key>
		<dict>
			<key>comment</key>
			<string>Not after `.` (a field), but after `..` (a range).</string>
			<key>name</key>
			<string>variable.other.rust-lite</string>
			<key>match</key>
			<string>\b(?&lt;!(?&lt;!\.)\.)[a-z_][a-z0-9_]*\b</string>
		</dict>
	</dict>
</dict>
</plist>
