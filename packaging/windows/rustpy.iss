; Inno Setup 6.3+ script for the RustPy Windows installer (https://jrsoftware.org/isinfo.php).
;
; Build it with packaging\windows\build.ps1 (which builds the release binary first), or run
;   ISCC.exe /DMyAppVersion=0.1.0 packaging\windows\rustpy.iss
;
; Optional preprocessor defines (ISCC /DName=Value):
;   MyAppVersion  version shown by the installer (default 0.1.0; build.ps1 passes Cargo.toml's)
;   BinDir        directory containing rustpy.exe (default ..\..\target\release)
;   OutDir        directory for the setup .exe (default ..\..\target\windows)
;   Arch          x86_64 (default) or arm64: allowed architectures and the file name
;   IconFile      .ico for the installer, the shortcuts and the file types (default:
;                 rustpy.ico next to this script if present; build.ps1 renders one from
;                 packaging\linux\rustpy.svg when ImageMagick is installed)
; Relative paths are resolved against the directory of this script.
;
; Installs rustpy.exe and a Start Menu shortcut, per user by default (no administrator rights;
; an administrator can choose "all users"). Optional tasks, all unchecked by default:
; a desktop shortcut; adding the installation folder to PATH; .py,
; .pyw, .pyi and .ipynb file associations; the Explorer context menu entries "Open Folder as
; RustPy Project" (folders) and "Edit with RustPy" (files). The uninstaller removes every
; registry entry and the PATH entry it added; settings in %APPDATA%\rustpy stay.

#define MyAppName "RustPy"
#ifndef MyAppVersion
#define MyAppVersion "0.1.0"
#endif
#define MyAppPublisher "RustPy contributors"
#define MyAppURL "https://github.com/themuddfamily/rustpy"
#define MyAppExeName "rustpy.exe"
#ifndef BinDir
#define BinDir "..\..\target\release"
#endif
#ifndef OutDir
#define OutDir "..\..\target\windows"
#endif
#ifndef NativeLicenses
#error NativeLicenses must name the reviewed source archive generated by build.ps1
#endif
#ifndef Arch
#define Arch "x86_64"
#endif
#ifndef IconFile
#if FileExists(AddBackslash(SourcePath) + "rustpy.ico")
#define IconFile AddBackslash(SourcePath) + "rustpy.ico"
#endif
#endif
#ifdef IconFile
#define AppIconPath "{app}\rustpy.ico"
#else
#define AppIconPath "{app}\rustpy.exe"
#endif

[Setup]
; The AppId identifies the installation for upgrades and uninstall: never change it.
AppId={{8C1B9B9E-4B4E-4F7C-9D53-2A2B5E3C7F10}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}/releases
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputDir={#OutDir}
OutputBaseFilename=rustpy-{#MyAppVersion}-windows-{#Arch}-setup
#if Arch == "arm64"
ArchitecturesAllowed=arm64
ArchitecturesInstallIn64BitMode=arm64
#elif Arch == "x86_64"
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
#else
#error Arch must be x86_64 or arm64
#endif
MinVersion=10.0
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
ChangesAssociations=yes
; Tells Explorer and new terminals about a changed PATH (task "addtopath").
ChangesEnvironment=yes
; Per-user install by default; the dialog lets an administrator install for all users
; (HKA then means HKLM instead of HKCU, {autopf} Program Files instead of %LOCALAPPDATA%\Programs).
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
UninstallDisplayName={#MyAppName}
UninstallDisplayIcon={#AppIconPath}
#ifdef IconFile
SetupIconFile={#IconFile}
#endif

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "addtopath"; Description: "Add the {#MyAppName} folder to the PATH (run ""rustpy"" in new terminals)"; GroupDescription: "Update PATH variable:"; Flags: unchecked
Name: "associate"; Description: "Open these file types with {#MyAppName} (adds it to ""Open with"" and the default-app choices):"; GroupDescription: "Create associations:"; Flags: unchecked
Name: "associate\py"; Description: ".py (Python source)"; Flags: unchecked
Name: "associate\pyw"; Description: ".pyw (Python GUI script)"; Flags: unchecked
Name: "associate\pyi"; Description: ".pyi (Python stub)"; Flags: unchecked
Name: "associate\ipynb"; Description: ".ipynb (Jupyter notebook)"; Flags: unchecked
Name: "contextmenu"; Description: "Add to the Explorer context menu:"; GroupDescription: "Update context menu:"; Flags: unchecked
Name: "contextmenu\folder"; Description: """Open Folder as {#MyAppName} Project"" on folders"; Flags: unchecked
Name: "contextmenu\file"; Description: """Edit with {#MyAppName}"" on files"; Flags: unchecked

[Files]
Source: "{#BinDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\THIRD-PARTY-NOTICES.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#NativeLicenses}"; DestDir: "{app}"; DestName: "Native-Licenses.zip"; Flags: ignoreversion
Source: "..\..\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
#ifdef IconFile
Source: "{#IconFile}"; DestDir: "{app}"; DestName: "rustpy.ico"; Flags: ignoreversion
#endif

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{#AppIconPath}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{#AppIconPath}"; Tasks: desktopicon

[Registry]
; Every key and value below is removed on uninstall: keys RustPy owns with uninsdeletekey,
; values in shared keys with uninsdeletevalue, and shared keys the installer may have created
; (.pyi, .ipynb, OpenWithProgids, RegisteredApplications) with uninsdeletekeyifempty. Keys
; marked ifempty come before their subkeys, as the uninstaller works bottom-up.
;
; "rustpy" in the Run dialog (Win+R) and in `start rustpy`.
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\App Paths\{#MyAppExeName}"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName}"; Flags: uninsdeletekey

; File associations (tasks "associate\..."): a RustPy.<ext> ProgID listed under
; OpenWithProgids. The current default handler (e.g. the Python launcher) stays the default;
; RustPy is offered in "Open with" and in Settings > Apps > Default apps.
Root: HKA; Subkey: "Software\Classes\.py"; Flags: uninsdeletekeyifempty; Tasks: associate\py
Root: HKA; Subkey: "Software\Classes\.py\OpenWithProgids"; Flags: uninsdeletekeyifempty; Tasks: associate\py
Root: HKA; Subkey: "Software\Classes\.py\OpenWithProgids"; ValueType: string; ValueName: "RustPy.py"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associate\py
Root: HKA; Subkey: "Software\Classes\RustPy.py"; ValueType: string; ValueName: ""; ValueData: "Python Source File"; Flags: uninsdeletekey; Tasks: associate\py
Root: HKA; Subkey: "Software\Classes\RustPy.py\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{#AppIconPath},0"; Tasks: associate\py
Root: HKA; Subkey: "Software\Classes\RustPy.py\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: associate\py

Root: HKA; Subkey: "Software\Classes\.pyw"; Flags: uninsdeletekeyifempty; Tasks: associate\pyw
Root: HKA; Subkey: "Software\Classes\.pyw\OpenWithProgids"; Flags: uninsdeletekeyifempty; Tasks: associate\pyw
Root: HKA; Subkey: "Software\Classes\.pyw\OpenWithProgids"; ValueType: string; ValueName: "RustPy.pyw"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associate\pyw
Root: HKA; Subkey: "Software\Classes\RustPy.pyw"; ValueType: string; ValueName: ""; ValueData: "Python GUI Script"; Flags: uninsdeletekey; Tasks: associate\pyw
Root: HKA; Subkey: "Software\Classes\RustPy.pyw\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{#AppIconPath},0"; Tasks: associate\pyw
Root: HKA; Subkey: "Software\Classes\RustPy.pyw\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: associate\pyw

Root: HKA; Subkey: "Software\Classes\.pyi"; Flags: uninsdeletekeyifempty; Tasks: associate\pyi
Root: HKA; Subkey: "Software\Classes\.pyi\OpenWithProgids"; Flags: uninsdeletekeyifempty; Tasks: associate\pyi
Root: HKA; Subkey: "Software\Classes\.pyi\OpenWithProgids"; ValueType: string; ValueName: "RustPy.pyi"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associate\pyi
Root: HKA; Subkey: "Software\Classes\RustPy.pyi"; ValueType: string; ValueName: ""; ValueData: "Python Stub File"; Flags: uninsdeletekey; Tasks: associate\pyi
Root: HKA; Subkey: "Software\Classes\RustPy.pyi\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{#AppIconPath},0"; Tasks: associate\pyi
Root: HKA; Subkey: "Software\Classes\RustPy.pyi\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: associate\pyi

Root: HKA; Subkey: "Software\Classes\.ipynb"; Flags: uninsdeletekeyifempty; Tasks: associate\ipynb
Root: HKA; Subkey: "Software\Classes\.ipynb\OpenWithProgids"; Flags: uninsdeletekeyifempty; Tasks: associate\ipynb
Root: HKA; Subkey: "Software\Classes\.ipynb\OpenWithProgids"; ValueType: string; ValueName: "RustPy.ipynb"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associate\ipynb
Root: HKA; Subkey: "Software\Classes\RustPy.ipynb"; ValueType: string; ValueName: ""; ValueData: "Jupyter Notebook"; Flags: uninsdeletekey; Tasks: associate\ipynb
Root: HKA; Subkey: "Software\Classes\RustPy.ipynb\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{#AppIconPath},0"; Tasks: associate\ipynb
Root: HKA; Subkey: "Software\Classes\RustPy.ipynb\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: associate\ipynb

; rustpy.exe as an application for "Open with" (shown as "RustPy") with its file types.
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "{#MyAppName}"; Flags: uninsdeletekey; Tasks: associate\py or associate\pyw or associate\pyi or associate\ipynb
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: associate\py or associate\pyw or associate\pyi or associate\ipynb
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\SupportedTypes"; ValueType: string; ValueName: ".py"; ValueData: ""; Tasks: associate\py
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\SupportedTypes"; ValueType: string; ValueName: ".pyw"; ValueData: ""; Tasks: associate\pyw
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\SupportedTypes"; ValueType: string; ValueName: ".pyi"; ValueData: ""; Tasks: associate\pyi
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\SupportedTypes"; ValueType: string; ValueName: ".ipynb"; ValueData: ""; Tasks: associate\ipynb

; Default Programs registration (Settings > Apps > Default apps > RustPy).
Root: HKA; Subkey: "Software\RegisteredApplications"; Flags: uninsdeletekeyifempty; Tasks: associate\py or associate\pyw or associate\pyi or associate\ipynb
Root: HKA; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "{#MyAppName}"; ValueData: "Software\{#MyAppName}\Capabilities"; Flags: uninsdeletevalue; Tasks: associate\py or associate\pyw or associate\pyi or associate\ipynb
Root: HKA; Subkey: "Software\{#MyAppName}"; Flags: uninsdeletekeyifempty; Tasks: associate\py or associate\pyw or associate\pyi or associate\ipynb
Root: HKA; Subkey: "Software\{#MyAppName}\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "{#MyAppName}"; Flags: uninsdeletekey; Tasks: associate\py or associate\pyw or associate\pyi or associate\ipynb
Root: HKA; Subkey: "Software\{#MyAppName}\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "Python IDE written in Rust"; Tasks: associate\py or associate\pyw or associate\pyi or associate\ipynb
Root: HKA; Subkey: "Software\{#MyAppName}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".py"; ValueData: "RustPy.py"; Tasks: associate\py
Root: HKA; Subkey: "Software\{#MyAppName}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".pyw"; ValueData: "RustPy.pyw"; Tasks: associate\pyw
Root: HKA; Subkey: "Software\{#MyAppName}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".pyi"; ValueData: "RustPy.pyi"; Tasks: associate\pyi
Root: HKA; Subkey: "Software\{#MyAppName}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".ipynb"; ValueData: "RustPy.ipynb"; Tasks: associate\ipynb

; Explorer context menu on folders and on the background of an open folder
; (task "contextmenu\folder").
Root: HKA; Subkey: "Software\Classes\Directory\shell\RustPy"; ValueType: string; ValueName: ""; ValueData: "Open Folder as {#MyAppName} Project"; Flags: uninsdeletekey; Tasks: contextmenu\folder
Root: HKA; Subkey: "Software\Classes\Directory\shell\RustPy"; ValueType: string; ValueName: "Icon"; ValueData: "{#AppIconPath}"; Tasks: contextmenu\folder
Root: HKA; Subkey: "Software\Classes\Directory\shell\RustPy\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: contextmenu\folder
Root: HKA; Subkey: "Software\Classes\Directory\Background\shell\RustPy"; ValueType: string; ValueName: ""; ValueData: "Open Folder as {#MyAppName} Project"; Flags: uninsdeletekey; Tasks: contextmenu\folder
Root: HKA; Subkey: "Software\Classes\Directory\Background\shell\RustPy"; ValueType: string; ValueName: "Icon"; ValueData: "{#AppIconPath}"; Tasks: contextmenu\folder
Root: HKA; Subkey: "Software\Classes\Directory\Background\shell\RustPy\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%V"""; Tasks: contextmenu\folder
; "Edit with RustPy" on every file (task "contextmenu\file").
Root: HKA; Subkey: "Software\Classes\*\shell\RustPy.Edit"; ValueType: string; ValueName: ""; ValueData: "Edit with {#MyAppName}"; Flags: uninsdeletekey; Tasks: contextmenu\file
Root: HKA; Subkey: "Software\Classes\*\shell\RustPy.Edit"; ValueType: string; ValueName: "Icon"; ValueData: "{#AppIconPath}"; Tasks: contextmenu\file
Root: HKA; Subkey: "Software\Classes\*\shell\RustPy.Edit\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: contextmenu\file

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
// Task "addtopath": {app} is appended to the user's PATH (HKCU\Environment) or, for an
// all-users installation, to the system PATH, and removed again on uninstall (or when an
// upgrade runs with the task unchecked). ChangesEnvironment=yes broadcasts the change.

function EnvRootKey: Integer;
begin
  if IsAdminInstallMode then
    Result := HKEY_LOCAL_MACHINE
  else
    Result := HKEY_CURRENT_USER;
end;

function EnvSubkey: String;
begin
  if IsAdminInstallMode then
    Result := 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment'
  else
    Result := 'Environment';
end;

// Removes every entry equal to Dir (ignoring case and a trailing backslash) from the
// semicolon-separated list Paths. Returns True when there was one.
function RemovePathEntry(var Paths: String; Dir: String): Boolean;
var
  Rest, Entry, Kept: String;
  P: Integer;
begin
  Result := False;
  Kept := '';
  Rest := Paths;
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    if P = 0 then
    begin
      Entry := Rest;
      Rest := '';
    end
    else
    begin
      Entry := Copy(Rest, 1, P - 1);
      Delete(Rest, 1, P);
    end;
    if CompareText(RemoveBackslashUnlessRoot(Trim(Entry)), RemoveBackslashUnlessRoot(Dir)) = 0 then
      Result := True
    else if Entry <> '' then
    begin
      if Kept <> '' then
        Kept := Kept + ';';
      Kept := Kept + Entry;
    end;
  end;
  if Result then
    Paths := Kept;
end;

procedure AddToPath(Dir: String);
var
  Paths, Probe: String;
begin
  if not RegQueryStringValue(EnvRootKey, EnvSubkey, 'Path', Paths) then
    Paths := '';
  Probe := Paths;
  if RemovePathEntry(Probe, Dir) then
    exit;
  if (Paths <> '') and (Copy(Paths, Length(Paths), 1) <> ';') then
    Paths := Paths + ';';
  Paths := Paths + Dir;
  if not RegWriteExpandStringValue(EnvRootKey, EnvSubkey, 'Path', Paths) then
    Log('Could not add ' + Dir + ' to the PATH');
end;

procedure RemoveFromPath(Dir: String);
var
  Paths: String;
begin
  if RegQueryStringValue(EnvRootKey, EnvSubkey, 'Path', Paths) then
    if RemovePathEntry(Paths, Dir) then
      if not RegWriteExpandStringValue(EnvRootKey, EnvSubkey, 'Path', Paths) then
        Log('Could not remove ' + Dir + ' from the PATH');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    if WizardIsTaskSelected('addtopath') then
      AddToPath(ExpandConstant('{app}'))
    else
      RemoveFromPath(ExpandConstant('{app}'));
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
    RemoveFromPath(ExpandConstant('{app}'));
end;
