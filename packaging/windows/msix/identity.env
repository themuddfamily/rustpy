# MSIX package identity. PLACEHOLDERS until the Partner Center account exists: copy the
# values from Partner Center > (the app) > Product management > Product identity.
# Each value can also be overridden with an environment variable of the same name
# prefixed by RUSTPY_MSIX_ (e.g. RUSTPY_MSIX_PUBLISHER) without editing this file.
#
# Package/Identity/Name, e.g. 12345RustPy.RustPy
IDENTITY_NAME=RustPy.RustPy.Placeholder
# Package/Identity/Publisher, e.g. CN=6B2E3A10-1234-4C5D-9E8F-0123456789AB. For local
# test signing the self-signed certificate is created with exactly this subject.
PUBLISHER=CN=RustPy Placeholder Publisher
# Package/Properties/PublisherDisplayName (the Partner Center publisher display name)
PUBLISHER_DISPLAY_NAME=RustPy (placeholder publisher)
# The reserved app name
DISPLAY_NAME=RustPy
